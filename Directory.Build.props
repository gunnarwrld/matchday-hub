<Project>

  <!--
    Shared MSBuild settings for every project in the solution.
    Node analogy: this is the "compilerOptions" block of a root tsconfig.json
    that each project inherits, plus the strict-mode flags.
  -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
